# ============================================================
# ComplyTrade — Model Endpoints Configuration
# ============================================================
# Change these values to switch between model hosts.
# Restart the server after making changes.
# ============================================================

# ── GLM OCR (Step 1 — Raw OCR extraction) ──
GLM_OCR_URL=http://34.171.200.116/api/ocr
GLM_OCR_MODEL=glm-ocr
# GLM_OCR_URL=http://10.20.10.3:8001/api/ocr
# GLM_OCR_URL=http://10.20.10.2:8001/api/ocr

# ── Qwen VLM 72B (Steps 2-9 — Vision tasks: classification, extraction) ──
QWEN_VLM_URL=http://35.192.15.206/vllm/v1/chat/completions
QWEN_VLM_MODEL=Qwen2.5-VL-72B-Instruct-AWQ
# QWEN_VLM_URL=http://10.20.10.2:8085/v1/chat/completions
# QWEN_VLM_MODEL=/home/aigenics/AI_MODELS/Qwen2.5-VL-72B-Instruct-AWQ

# ── Qwen VLM 7B (Local fallback — smaller model) ──
# QWEN_VLM_URL=http://10.20.10.3:8000/v1/chat/completions
# QWEN_VLM_MODEL=/home/aigenics/AI_MODELS/Qwen2.5-VL-7B-Instruct

# ── Qwen Text LLM 72B (Steps 6, 12, 14 — Text-only: decomposition, verification) ──
QWEN_TEXT_LLM_URL=http://34.61.17.191/vllm/v1/chat/completions
QWEN_TEXT_LLM_MODEL=Qwen2.5-72B-Instruct

# ── VLM Model Size (7B or 72B — controls which VLM is used for Steps 2-9) ──
VLM_MODEL_SIZE=72B

# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8082
